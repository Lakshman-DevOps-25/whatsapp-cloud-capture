# ─── WhatsApp Cloud API (Meta Developer Console) ─────────
# WA_PHONE_NUMBER_ID  → the numeric ID used in API calls (e.g. 123456789012345)
#                       Meta Dashboard → WhatsApp → API Setup → Phone Number ID
WA_PHONE_NUMBER_ID=1023074700896441

# WA_BUSINESS_PHONE   → your actual phone number in E.164 (stored in MongoDB as from/to)
#                       e.g. 919000000000  (no +, no spaces, include country code)
#                       Meta Dashboard → WhatsApp → API Setup → Phone Number display value
WA_BUSINESS_PHONE=+15556300938      # ← REQUIRED: your real WA number (E.164, no +)

WA_BUSINESS_ACCOUNT_ID=1451758683349250
WA_ACCESS_
                

# ─── Token Auto-Renewal (tokenService.js) ────────────────
# WA_APP_ID      → Meta App ID  (App Settings > Basic > App ID)
# WA_APP_SECRET  → Meta App Secret (App Settings > Basic > App Secret)
# WA_TOKEN_GENERATED_AT → Auto-set by generateLongToken() — do not edit
WA_APP_ID=922666820611700
WA_APP_SECRET=903d8df4bd61131f967d2767781648a3
WA_TOKEN_GENERATED_AT=

# Admin secret — protects /api/admin/* endpoints
ADMIN_SECRET=rpZMtdEqD83y9czj7zWH
WA_VERIFY_TOKEN=test123
WA_API_VERSION=v19.0

# ─── Render API (for persistent token storage on Render) ─
# Without these, token updates are lost on restart.
# RENDER_API_KEY  → Render Dashboard → Account → API Keys → Create API Key
# RENDER_SERVICE_ID → Render Dashboard → Your Service → URL contains /srv-XXXXXXX
RENDER_API_KEY=rnd_tnG2REg8aqt09qhlyItahKXE3f0b
RENDER_SERVICE_ID=srv-d82mclfavr4c73e11qa0

# ─── Media Storage ────────────────────────────────────────
# 'local'  → saves files to ./uploads/ folder
# 'minio'  → saves to MinIO object storage (fill keys below)
# MEDIA_STORAGE=local
# UPLOAD_DIR=./uploads
MEDIA_STORAGE=minio
UPLOAD_DIR=./

# MinIO (only needed if MEDIA_STORAGE=minio)
# Self-hosted MinIO endpoint — no trailing slash
MINIO_ENDPOINT=play.min.io
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whatsapp-media
# Public base URL used to build object URLs (set to MinIO console proxy or CDN)
# Example: http://localhost:9000  or  https://media.yourdomain.com
MINIO_PUBLIC_URL=https://play.min.io:9000
MINIO_INTERNAL_URL=https://play.min.io:9000


